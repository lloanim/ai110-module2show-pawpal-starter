classDiagram
    %% PawPal+ class design. Keep this file updated so it matches your final implementation.

    class Owner {
        +string name
        +int time_available
        +list~string~ preferences
        +list~Pet~ pets
        +list~Task~ tasks
        +add_pet(pet) None
        +add_task(task) None
    }

    class Pet {
        +string name
        +string species
        +string breed
        +int age
        +describe() string
    }

    class Task {
        +string title
        +int duration_minutes
        +string priority
        +priority_score() int
    }

    class Scheduler {
        +list~Task~ tasks
        +int time_available
        +sort_tasks() list~Task~
        +build_plan() list~Task~
        +explain() string
    }

    Owner "1" --> "*" Pet : owns
    Owner "1" --> "*" Task : adds
    Scheduler "1" --> "*" Task : schedules
